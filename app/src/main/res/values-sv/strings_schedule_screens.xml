    <string name="reminder_prompt_message">Kids Activity Tracker påminner dig innan aktiviteterna börjar och efter att skolan är slut. Fortsätt att bevilja de behörigheter som påminnelserna kräver – aviseringar, exakta larm och batterioptimering – en efter en.</string>
    <!-- Reminder Prompt Dialog: Confirm button text to start granting permissions -->
    <string name="reminder_prompt_continue">Fortsätt</string>
    <!-- Reminder Prompt Dialog: Dismiss button text to postpone setting up permissions -->
    <string name="reminder_prompt_not_now">Inte nu</string>
