    <string name="reminder_prompt_message">L\'application « Kids Activity Tracker » vous envoie des rappels avant le début des activités et à la fin de la journée d\'école. Continuez à accorder les autorisations nécessaires au bon fonctionnement des rappels — notifications, alarmes précises et optimisation de la batterie — les unes après les autres.</string>
    <!-- Reminder Prompt Dialog: Confirm button text to start granting permissions -->
    <string name="reminder_prompt_continue">Continuer</string>
    <!-- Reminder Prompt Dialog: Dismiss button text to postpone setting up permissions -->
    <string name="reminder_prompt_not_now">Pas maintenant</string>
