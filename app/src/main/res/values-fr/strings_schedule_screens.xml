    <plurals name="today_activities_count">
        <item quantity="one">%1$d activité aujourd\'hui</item>
        <item quantity="other">%1$d activités aujourd\'hui</item>
        <item quantity="many">%1$d activités aujourd\'hui</item>
    </plurals>
