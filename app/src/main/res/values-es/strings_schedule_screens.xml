<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dashboard: Header greeting shown when no kids have been added yet -->
    <string name="welcome_title">¡Bienvenidos!</string>
    <!-- Dashboard: Subtitle message encouraging the user to add their first kid -->
    <string name="welcome_add_first_kid_message">Añade a tu primer hijo para empezar a llevar un seguimiento de su colegio y sus actividades.</string>
    <!-- Dashboard: Button text in empty state to add a new kid -->
    <string name="welcome_add_kid">Añadir un niño</string>
    <!-- Dashboard: Main header title for the Today view -->
    <string name="dashboard_title">Hoy</string>
    <!-- Dashboard: Accessibility text for the Settings icon button -->
    <string name="dashboard_settings">Configuración</string>
    <!-- Dashboard: Floating Action Button label to create a new activity -->
    <string name="dashboard_add_activity">Añadir actividad</string>
    <!-- Dashboard: Title of card showing next upcoming event. %1$s = activity name (e.g. "Football") -->
    <string name="dashboard_up_next_format">A continuación: %1$s</string>
    <!-- Dashboard: Subtitle on upcoming event card. %1$s = kid's name, %2$d = minutes until trigger -->
    <string name="dashboard_up_next_details_format">Por %1$s • en %2$d minutos</string>
    <!-- Dashboard: Header above today's activity timeline list -->
    <string name="dashboard_today_schedule">Programa de hoy</string>
    <!-- Dashboard: Empty state message when there are no activities scheduled for today -->
    <string name="today_no_activities">🎉 ¡Hoy no hay actividades!</string>
    <!-- Dashboard: Badge text indicating reminder alarms are muted for an activity -->
    <string name="dashboard_alarms_disabled">Alarmas desactivadas</string>
    <!-- Dashboard: Text button navigating from Today view to the full Week tab -->
    <string name="dashboard_view_full_week">Ver toda la semana</string>
    <!-- Dashboard: Title on top warning banner when exact alarm or notification permissions are missing -->
    <string name="dashboard_permissions_banner_title">Los recordatorios están desactivados</string>
    <!-- Dashboard: Subtitle on warning banner prompting user to grant missing permissions -->
    <string name="dashboard_permissions_banner_message">Faltan los permisos necesarios: pulsa aquí para concederlos</string>
    <!-- Dashboard: Accessibility action text to dismiss the permissions warning banner -->
    <string name="dashboard_permissions_banner_dismiss">Ignorar los recordatorios de advertencia</string>
    <!-- Reminder Prompt Dialog: Title asking user permission to configure reminder notifications -->
    <string name="reminder_prompt_title">¿Permitir recordatorios?</string>
    <!-- Reminder Prompt Dialog: Detailed message explaining required permissions (notifications, exact alarms, battery optimization) -->
    <string name="reminder_prompt_message">Kids Activity Tracker te avisa antes de que empiecen las actividades y al terminar el colegio. Sigue concediendo, una tras otra, las autorizaciones necesarias para los recordatorios: notificaciones, alarmas precisas y optimización de la batería.</string>
    <!-- Reminder Prompt Dialog: Confirm button text to start granting permissions -->
    <string name="reminder_prompt_continue">Continuar</string>
    <!-- Reminder Prompt Dialog: Dismiss button text to postpone setting up permissions -->
    <string name="reminder_prompt_not_now">Ahora no</string>
    <!-- Dashboard: Summary header showing number of scheduled activities for today. %1$d = activity count -->
    <plurals name="today_activities_count">
        <item quantity="one">%1$d actividad hoy</item>
        <item quantity="other">%1$d actividades hoy</item>
        <item quantity="many">%1$d actividades hoy</item>
    </plurals>
    <!-- Week View: Header title displaying visible date range. %1$s = start date (e.g. "Oct 19"), %2$s = end date (e.g. "Oct 25") -->
    <string name="week_range_title_format">%1$s - %2$s</string>
    <!-- Week View: Navigation button accessibility label to view the previous week -->
    <string name="week_previous_week">La semana pasada</string>
    <!-- Week View: Navigation button accessibility label to view the next week -->
    <string name="week_next_week">La semana que viene</string>
    <!-- Week View: Empty state message shown when no kids exist in database -->
    <string name="week_add_kid_to_get_started">¡Añade un niño para empezar!</string>
    <!-- Week View: Empty state message when no activities fall in the current week -->
    <string name="week_no_activities_this_week">Esta semana no hay actividades</string>
    <!-- Week View: Badge text indicating alarms are turned off for a row -->
    <string name="week_alarms_disabled">Alarmas desactivadas</string>
    <!-- Month View: Navigation button accessibility label to view the previous month -->
    <string name="month_previous_month">Mes anterior</string>
    <!-- Month View: Navigation button accessibility label to view the next month -->
    <string name="month_next_month">El mes que viene</string>
    <!-- Month View: Empty state text when no activities exist in selected month -->
    <string name="month_no_activities">No hay actividades</string>
    <!-- Month View: Badge text indicating alarms are turned off -->
    <string name="month_alarms_disabled">Alarmas desactivadas</string>
    <!-- Daily Schedule Screen: Navigation back button label -->
    <string name="daily_back">Atrás</string>
    <!-- Daily Schedule Screen: Button accessibility label to go to yesterday -->
    <string name="daily_previous_day">El día anterior</string>
    <!-- Daily Schedule Screen: Button accessibility label to go to tomorrow -->
    <string name="daily_next_day">Al día siguiente</string>
    <!-- Daily Schedule Screen: Empty state message for selected date -->
    <string name="daily_no_activities_scheduled">No hay actividades programadas para hoy</string>
    <!-- Daily Schedule Screen: Badge text indicating alarms are disabled -->
    <string name="daily_alarms_disabled">Alarmas desactivadas</string>
    <!-- Kid Selection Screen: Header title for screen picking kids for daily filter -->
    <string name="kid_selection_title">Seleccionar «Niños»</string>
    <!-- Kid Selection Screen: Button label to navigate to Add Kid form -->
    <string name="kid_selection_add_kid">Añadir un niño</string>
    <!-- Kid Selection Screen: Button text to select all kids in list -->
    <string name="kid_selection_select_all">Seleccionar todo</string>
    <!-- Kid Selection Screen: Button text to clear all checked kids in list -->
    <string name="kid_selection_deselect_all">Deseleccionar todo</string>
    <!-- Kid Selection Screen: Main action button to open daily schedule for chosen kids. %1$d = selected count -->
    <string name="kid_selection_view_schedule_format">Ver calendario (%1$d seleccionados)</string>
    <!-- Kid Selection Screen: Empty state text when no kids exist -->
    <string name="kid_selection_no_kids_added_yet">Aún no se ha añadido ningún niño.</string>
    <!-- Kid Selection Screen: Subtitle in kid card row. %1$s = school name -->
    <string name="kid_selection_school_format">Colegio: %1$s</string>
    <!-- Kids Management Screen: Top app bar title -->
    <string name="kids_management_title">Niños</string>
    <!-- Kids Management Screen: Top app bar back button label -->
    <string name="kids_management_back">Atrás</string>
    <!-- Kids Management Screen: Button to add a new kid -->
    <string name="kids_management_add_kid">Añadir un niño</string>
    <!-- Kids Management Screen: Empty state text when no kids exist -->
    <string name="kids_management_no_kids_added_yet">Aún no se ha añadido ningún niño.</string>
    <!-- Kids Management Screen: Subtitle showing school name in kid row. %1$s = school name -->
    <string name="kids_management_school_format">Colegio: %1$s</string>
    <!-- Delete All Activities: Button label to delete all activities belonging to a kid -->
    <string name="delete_all_activities_button">Eliminar todas las actividades</string>
    <!-- Delete All Activities Dialog: Title of confirmation dialog -->
    <string name="delete_all_activities_dialog_title">¿Eliminar todas las actividades?</string>
    <!-- Delete All Activities Dialog: Confirmation warning text. %1$s = kid's name -->
    <string name="delete_all_activities_dialog_message_format">¿Estás seguro de que quieres eliminar todas las actividades y cancelar todos los recordatorios de %1$s? Esta acción no se puede deshacer.</string>
    <!-- Delete All Activities Dialog: Confirm destructive action button -->
    <string name="delete_all_activities_confirm">Eliminar</string>
    <!-- Delete All Activities Dialog: Cancel action button -->
    <string name="delete_all_activities_cancel">Cancelar</string></resources>
