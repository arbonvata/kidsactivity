    <string name="reminder_prompt_message">Der „Kids Activity Tracker“ erinnert dich vor Beginn der Aktivitäten und nach Schulschluss. Erteile nacheinander die für die Erinnerungen erforderlichen Berechtigungen – Benachrichtigungen, präzise Alarme und Akkuoptimierung.</string>
    <!-- Reminder Prompt Dialog: Confirm button text to start granting permissions -->
    <string name="reminder_prompt_continue">Weiter</string>
    <!-- Reminder Prompt Dialog: Dismiss button text to postpone setting up permissions -->
    <string name="reminder_prompt_not_now">Nicht jetzt</string>
